VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# When running python -m src.main server (recommended), MCP is available on
# the same host:port at /mcp -- see VITE_MCP_BASE_URL below.

# Demo mode -- see src/lib/demo.ts and src/components/demo/DemoOnboarding.tsx.
# Set to true for a static deployment with no backend (e.g. Vercel); leave
# false for local dev against the real backend above.
#
# When true, the app boots into a blocking welcome screen where the visitor
# either continues WITHOUT an API key (whole UI visible but inert) or enters
# their OWN Google API key + Gemini model. The key/model live only in React
# memory (stores/demoStore.ts) and are lost on reload -- never persisted and
# never seen by any backend: the browser calls Gemini directly.

VITE_DEMO_MODE=false

# --- Provider config for ui/src/lib/providers.ts ---
# Mirrors the Python provider architecture in src/nlp/llm/providers.py.
# The frontend also has its own models.json at src/config/models/models.json
# with per-model capabilities (context_window, temperature, etc.)
# — fully independent from the backend's model configuration.
#
# These are optional when VITE_DEMO_MODE=false and the backend API is
# available (GET /api/v1/config/providers); they become the primary
# source when there is no backend (VITE_DEMO_MODE=true).
#
# Backend URLs (backend = concrete runtime):
VITE_LLM_FLM_URL=http://127.0.0.1:52625/v1
VITE_LLM_OLLAMA_URL=http://127.0.0.1:11434
VITE_LLM_GEMINI_URL=https://generativelanguage.googleapis.com/v1beta/openai/
VITE_GEMINI_API_KEY=
#
# Role -> backend,model (each pipeline role maps to a concrete backend+model):
VITE_LLM_ROL_GENERATE=flm,qwen3.5:9b
VITE_LLM_ROL_REFORMULATE=ollama,qwen3.5:2b
VITE_LLM_ROL_REVIEW=gemini,gemini-2.5-flash-lite
VITE_LLM_ROL_SUPPLEMENT=flm,qwen3.5:9b

# --- MCP client for ui/src/lib/mcp.ts ---
# When the server runs in unified mode (python -m src.main server), MCP is
# served at /mcp on the same host:port as the API (http://host:8000/mcp/).
# The client constructs the full URL as new URL("/mcp", MCP_BASE_URL), so
# set MCP_BASE_URL to the same scheme + host + port as the API (no /api/v1).
# Bearer token must match MCP_BEARER_TOKEN in .env. Empty = no auth.

VITE_MCP_BASE_URL=http://127.0.0.1:8000
VITE_MCP_BEARER_TOKEN=

# OPTIONAL fallbacks for VITE_DEMO_MODE=true. Since the onboarding screen
# asks visitors for their own key/model (memory only, see demoStore.ts),
# these are only used when the visitor enters no key but the UI still needs
# defaults -- e.g. as a courtesy demo key for the "with-key" path.
# They end up in the public JS bundle: use a key scoped/rate-limited for
# this, never the same key as the real backend's GEMINI_API_KEY.

VITE_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-2.5-flash-lite
